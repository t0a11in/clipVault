<Application x:Class="ClipVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="ClipVault">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="C"
                                        FontSize="40"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Background="#2563EB" />
            </tb:TaskbarIcon.IconSource>

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Abrir"
                              Command="{Binding OpenCommand}" />
                    <MenuItem Header="Guardar clip actual"
                              Command="{Binding SaveCurrentCommand}" />
                    <MenuItem Header="Bloquear capturas"
                              Command="{Binding ToggleCaptureLockCommand}" />
                    <MenuItem Header="Categorías"
                              Command="{Binding OpenCategoriesCommand}" />
                    <Separator />
                    <MenuItem Header="Salir"
                              Command="{Binding ExitCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
