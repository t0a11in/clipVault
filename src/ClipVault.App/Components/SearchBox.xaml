<!--
    Componente de presentación: caja de búsqueda.
    Entradas: Text (bidireccional, se actualiza al escribir) y Placeholder.
    Esc o el botón × limpian el texto. FocusInput() permite enfocarla (Ctrl+F).
-->
<UserControl x:Class="ClipVault.App.Components.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border x:Name="Frame"
            Height="32"
            Padding="8,0,2,0"
            Background="{DynamicResource Cv.Brush.Surface}"
            BorderBrush="{DynamicResource Cv.Brush.InputBorder}"
            BorderThickness="{DynamicResource Cv.Border.Thickness}"
            CornerRadius="{DynamicResource Cv.Radius.Control}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       Style="{StaticResource Cv.Text.Icon}"
                       FontSize="14"
                       Foreground="{DynamicResource Cv.Brush.PlaceholderText}"
                       Text="&#xE721;" />
            <!-- Marcador de posición: visible solo con el campo vacío. -->
            <TextBlock x:Name="PlaceholderText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       TextTrimming="CharacterEllipsis"
                       Style="{StaticResource Cv.Text.Body}"
                       TextWrapping="NoWrap"
                       Foreground="{DynamicResource Cv.Brush.PlaceholderText}"
                       Text="{Binding Placeholder, ElementName=Root}" />
            <TextBox x:Name="Input"
                     Grid.Column="1"
                     Style="{StaticResource Cv.TextBox.Search}"
                     Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding Placeholder, ElementName=Root}"
                     PreviewKeyDown="OnInputPreviewKeyDown"
                     TextChanged="OnInputTextChanged"
                     GotKeyboardFocus="OnInputFocusChanged"
                     LostKeyboardFocus="OnInputFocusChanged" />
            <Button x:Name="ClearButton"
                    Grid.Column="2"
                    Width="26"
                    Height="26"
                    MinWidth="26"
                    Style="{StaticResource Cv.Button.Icon}"
                    FontSize="10"
                    Content="&#xE711;"
                    Visibility="Collapsed"
                    Click="OnClearClick"
                    ToolTip="Limpiar búsqueda (Esc)"
                    AutomationProperties.Name="Limpiar búsqueda" />
        </Grid>
    </Border>
</UserControl>
