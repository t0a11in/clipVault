<!--
    Componente de presentación: fila de un ítem de navegación.
    Entradas: Glyph, IconBrush (opcional), Label y Count (se oculta si es 0).
    Los nombres largos se truncan y el completo se ve en el ToolTip de quien lo usa.
-->
<UserControl x:Class="ClipVault.App.Components.NavItemRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Margin="0,0,10,0"
                   Text="{Binding Glyph, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Cv.Text.Icon}">
                    <Setter Property="Foreground" Value="{Binding IconBrush, ElementName=Root}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IconBrush, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Foreground" Value="{DynamicResource Cv.Brush.MutedText}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Cv.Font.Ui}"
                   FontSize="{DynamicResource Cv.FontSize.Body}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Text="{Binding Label, ElementName=Root}" />
        <TextBlock Grid.Column="2"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontWeight="Normal"
                   Text="{Binding Count, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Cv.Text.Small}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Count, ElementName=Root}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
