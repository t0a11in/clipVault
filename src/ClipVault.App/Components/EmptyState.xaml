<!--
    Componente de presentación: estado vacío reutilizable
    ("Selecciona una página", "Esta sección aún no tiene páginas", "No encontramos resultados"…).
    Entradas: Glyph, Title, Description, ActionText y ActionCommand.
    El botón solo aparece si se entrega ActionCommand.
-->
<UserControl x:Class="ClipVault.App.Components.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <StackPanel MaxWidth="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Center"
                   Style="{StaticResource Cv.Text.Icon}"
                   FontSize="28"
                   Foreground="{DynamicResource Cv.Brush.PlaceholderText}"
                   Text="{Binding Glyph, ElementName=Root}" />
        <TextBlock Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontWeight="SemiBold"
                   Style="{StaticResource Cv.Text.Body}"
                   Text="{Binding Title, ElementName=Root}" />
        <TextBlock Margin="0,4,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Style="{StaticResource Cv.Text.Muted}"
                   Text="{Binding Description, ElementName=Root}" />
        <Button Margin="0,14,0,0"
                HorizontalAlignment="Center"
                Content="{Binding ActionText, ElementName=Root}"
                Command="{Binding ActionCommand, ElementName=Root}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Cv.Button.Secondary}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActionCommand, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>
