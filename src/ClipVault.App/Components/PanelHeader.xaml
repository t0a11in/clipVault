<!--
    Componente de presentación: encabezado de columna ("Secciones", "Páginas"…).
    Entradas: Title y Actions (contenido libre a la derecha, p. ej. un botón "+").
-->
<UserControl x:Class="ClipVault.App.Components.PanelHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <Grid Height="40" Margin="12,0,6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource Cv.Text.Body}"
                   TextWrapping="NoWrap"
                   Text="{Binding Title, ElementName=Root}"
                   ToolTip="{Binding Title, ElementName=Root}" />
        <ContentPresenter Grid.Column="1"
                          VerticalAlignment="Center"
                          Content="{Binding Actions, ElementName=Root}" />
    </Grid>
</UserControl>
