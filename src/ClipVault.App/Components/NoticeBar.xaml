<!--
    Componente de presentación: aviso breve (toast) no bloqueante.
    Entradas: Message, IsOpen, Tone ("Success" | "Warning" | "Error") y DismissCommand.
    Se anuncia a lectores de pantalla (LiveSetting) y el tono no depende solo del color (icono).
-->
<UserControl x:Class="ClipVault.App.Components.NoticeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border x:Name="Frame"
            MinWidth="240"
            MaxWidth="420"
            Padding="12,8,6,8"
            CornerRadius="{DynamicResource Cv.Radius.Panel}"
            BorderThickness="{DynamicResource Cv.Border.Thickness}"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="{Binding Message, ElementName=Root}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Cv.Brush.SuccessBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cv.Brush.Success}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="Warning">
                        <Setter Property="Background" Value="{DynamicResource Cv.Brush.WarningBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Cv.Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="Error">
                        <Setter Property="Background" Value="{DynamicResource Cv.Brush.DangerBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Cv.Brush.Danger}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="0,0,10,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cv.Text.Icon}">
                        <Setter Property="Text" Value="&#xE73E;" />
                        <Setter Property="Foreground" Value="{DynamicResource Cv.Brush.Success}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="Warning">
                                <Setter Property="Text" Value="&#xE7BA;" />
                                <Setter Property="Foreground" Value="{DynamicResource Cv.Brush.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone, ElementName=Root}" Value="Error">
                                <Setter Property="Text" Value="&#xEA39;" />
                                <Setter Property="Foreground" Value="{DynamicResource Cv.Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Cv.Text.Body}"
                       Text="{Binding Message, ElementName=Root}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Width="26" Height="26" MinWidth="26"
                    Style="{StaticResource Cv.Button.Icon}" FontSize="10" Content="&#xE711;"
                    Command="{Binding DismissCommand, ElementName=Root}"
                    ToolTip="Cerrar aviso" AutomationProperties.Name="Cerrar aviso" />
        </Grid>
    </Border>
</UserControl>
