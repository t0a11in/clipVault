<!--
    Componente de presentación: tarjeta de un ítem de lista (página).
    Entradas: Title, Preview, Meta, IsFavorite, IsSensitive, HasCode y UseMonospacePreview.
    Los indicadores son iconos con ToolTip y nombre accesible: el estado no se
    comunica solo con color.
-->
<UserControl x:Class="ClipVault.App.Components.ListItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontFamily="{DynamicResource Cv.Font.Ui}"
                       FontSize="{DynamicResource Cv.FontSize.Body}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Text="{Binding Title, ElementName=Root}" />
            <StackPanel Grid.Column="1" Margin="6,0,0,0" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Cv.Text.Icon}"
                           Margin="4,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Cv.Brush.MutedText}"
                           Text="&#xE756;"
                           ToolTip="Contiene un comando"
                           AutomationProperties.Name="Contiene un comando"
                           Visibility="{Binding HasCode, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Cv.Text.Icon}"
                           Margin="4,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Cv.Brush.Sensitive}"
                           Text="&#xE72E;"
                           ToolTip="Dato sensible: contenido oculto"
                           AutomationProperties.Name="Contiene datos sensibles"
                           Visibility="{Binding IsSensitive, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Cv.Text.Icon}"
                           Margin="4,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Cv.Brush.Primary}"
                           Text="&#xE735;"
                           ToolTip="Favorito"
                           AutomationProperties.Name="Favorito"
                           Visibility="{Binding IsFavorite, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
        <TextBlock Margin="0,2,0,0"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Text="{Binding Preview, ElementName=Root}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Cv.Text.Small}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseMonospacePreview, ElementName=Root}" Value="True">
                            <Setter Property="FontFamily" Value="{DynamicResource Cv.Font.Code}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Margin="0,2,0,0"
                   Style="{StaticResource Cv.Text.Small}"
                   Foreground="{DynamicResource Cv.Brush.PlaceholderText}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Text="{Binding Meta, ElementName=Root}" />
    </StackPanel>
</UserControl>
