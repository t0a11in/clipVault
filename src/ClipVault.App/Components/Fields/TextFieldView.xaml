<!-- Componente: campo de texto en modo lectura. Entradas: Label y Value. -->
<UserControl x:Class="ClipVault.App.Components.Fields.TextFieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <StackPanel>
        <TextBlock Style="{StaticResource Cv.Text.FieldLabel}" Text="{Binding Label, ElementName=Root}" />
        <TextBox Style="{StaticResource Cv.TextBox.ReadOnly}"
                 Text="{Binding Value, ElementName=Root, Mode=OneWay}"
                 AutomationProperties.Name="{Binding Label, ElementName=Root}" />
    </StackPanel>
</UserControl>
