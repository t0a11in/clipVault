<!--
    Componente: campo sensible (etapa 7).
    Entradas: Label, Value (máscara o valor revelado), RevealText, RevealCommand y CopyCommand.
    Por defecto muestra ••••••••. "Mostrar temporalmente" lo revela unos segundos;
    "Copiar" pide confirmación (la gestiona el ViewModel).
-->
<UserControl x:Class="ClipVault.App.Components.Fields.SecretFieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="Dato sensible: contenido oculto">
            <TextBlock Style="{StaticResource Cv.Text.Icon}"
                       Margin="0,0,6,0"
                       FontSize="12"
                       Foreground="{DynamicResource Cv.Brush.Sensitive}"
                       Text="&#xE72E;" />
            <TextBlock Style="{StaticResource Cv.Text.FieldLabel}"
                       Margin="0"
                       Foreground="{DynamicResource Cv.Brush.Sensitive}"
                       Text="{Binding Label, ElementName=Root}" />
            <TextBlock Margin="6,0,0,0" Style="{StaticResource Cv.Text.Small}" Text="· dato sensible" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Padding="10,8,10,8"
                    Background="{DynamicResource Cv.Brush.SensitiveBackground}"
                    BorderBrush="{DynamicResource Cv.Brush.Sensitive}"
                    BorderThickness="{DynamicResource Cv.Border.Thickness}"
                    CornerRadius="{DynamicResource Cv.Radius.Control}"
                    ToolTip="Dato sensible: contenido oculto"
                    AutomationProperties.Name="Dato sensible">
                <TextBlock FontFamily="{DynamicResource Cv.Font.Code}"
                           Foreground="{DynamicResource Cv.Brush.Sensitive}"
                           TextWrapping="Wrap"
                           Text="{Binding Value, ElementName=Root}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Cv.Button.Secondary}"
                        Content="{Binding RevealText, ElementName=Root}"
                        Command="{Binding RevealCommand, ElementName=Root}"
                        ToolTip="Se vuelve a ocultar sola a los pocos segundos"
                        AutomationProperties.Name="{Binding RevealText, ElementName=Root}" />
                <Button Margin="6,0,0,0"
                        Style="{StaticResource Cv.Button.Icon}"
                        Content="&#xE8C8;"
                        Command="{Binding CopyCommand, ElementName=Root}"
                        ToolTip="Copiar el dato sensible (pide confirmación)"
                        AutomationProperties.Name="Copiar dato sensible" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
