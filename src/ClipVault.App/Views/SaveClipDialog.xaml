<Window x:Class="ClipVault.App.Views.SaveClipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guardar clip"
        Width="460"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,5" Text="Título" />
        <TextBox Grid.Row="1"
                 Margin="0,0,0,12"
                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="2" Margin="0,0,0,5" Text="Categoría" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          IsEditable="False"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="StorageValue"
                          SelectedValue="{Binding Category, Mode=TwoWay}"
                          ToolTip="Selecciona una categoría existente" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        MinWidth="34"
                        Padding="7,4"
                        Command="{Binding BeginAddCategoryCommand}"
                        Content="＋"
                        ToolTip="Agregar una categoría nueva" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,8,0,0"
                  Visibility="{Binding IsAddingCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnNewCategoryKeyDown"
                         ToolTip="Nombre de la categoría nueva" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        MinWidth="34"
                        Padding="7,4"
                        Command="{Binding AddCategoryCommand}"
                        Content="✓"
                        ToolTip="Agregar y seleccionar esta categoría" />
                <Button Grid.Column="2"
                        Margin="4,0,0,0"
                        MinWidth="34"
                        Padding="7,4"
                        Command="{Binding CancelAddCategoryCommand}"
                        Content="×"
                        ToolTip="Cancelar categoría nueva" />
            </Grid>

            <StackPanel Grid.Row="2"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        MinWidth="34"
                        Padding="7,4"
                        Command="{Binding CancelCommand}"
                        Content="×"
                        ToolTip="Cancelar" />
                <Button MinWidth="34"
                        Padding="7,4"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"
                        Content="💾"
                        ToolTip="Guardar clip" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
