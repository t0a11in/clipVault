<!--
    Tokens de diseño de la Biblioteca (especificación "ClipVault Library UI" v2.0).
    Regla: este diccionario NO define estilos implícitos (sin x:Key), para no
    alterar la apariencia del Historial existente. Todo se consume por clave.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Colores base ===== -->
    <Color x:Key="Cv.Color.Primary">#4F46E5</Color>
    <Color x:Key="Cv.Color.PrimaryHover">#4338CA</Color>
    <Color x:Key="Cv.Color.PrimaryPressed">#3730A3</Color>
    <Color x:Key="Cv.Color.OnPrimary">#FFFFFF</Color>
    <Color x:Key="Cv.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Cv.Color.SurfaceSubtle">#F8FAFC</Color>
    <Color x:Key="Cv.Color.TopBar">#F1F5F9</Color>
    <Color x:Key="Cv.Color.Border">#E2E8F0</Color>
    <Color x:Key="Cv.Color.InputBorder">#94A3B8</Color>
    <Color x:Key="Cv.Color.Text">#0F172A</Color>
    <Color x:Key="Cv.Color.MutedText">#475569</Color>
    <Color x:Key="Cv.Color.PlaceholderText">#64748B</Color>
    <Color x:Key="Cv.Color.Hover">#F1F5F9</Color>
    <Color x:Key="Cv.Color.Selected">#EEF2FF</Color>
    <Color x:Key="Cv.Color.SelectedText">#3730A3</Color>
    <Color x:Key="Cv.Color.SelectedIndicator">#4F46E5</Color>
    <Color x:Key="Cv.Color.Focus">#6366F1</Color>
    <Color x:Key="Cv.Color.Success">#15803D</Color>
    <Color x:Key="Cv.Color.SuccessBackground">#F0FDF4</Color>
    <Color x:Key="Cv.Color.Warning">#92400E</Color>
    <Color x:Key="Cv.Color.WarningBackground">#FFFBEB</Color>
    <Color x:Key="Cv.Color.Danger">#B91C1C</Color>
    <Color x:Key="Cv.Color.DangerHover">#991B1B</Color>
    <Color x:Key="Cv.Color.DangerBackground">#FEF2F2</Color>
    <Color x:Key="Cv.Color.Sensitive">#7E22CE</Color>
    <Color x:Key="Cv.Color.SensitiveBackground">#FAF5FF</Color>
    <Color x:Key="Cv.Color.DisabledBackground">#F1F5F9</Color>
    <Color x:Key="Cv.Color.DisabledText">#94A3B8</Color>

    <!-- ===== Pinceles (consumir siempre con DynamicResource) ===== -->
    <SolidColorBrush x:Key="Cv.Brush.Primary" Color="{StaticResource Cv.Color.Primary}" />
    <SolidColorBrush x:Key="Cv.Brush.PrimaryHover" Color="{StaticResource Cv.Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Cv.Brush.PrimaryPressed" Color="{StaticResource Cv.Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="Cv.Brush.OnPrimary" Color="{StaticResource Cv.Color.OnPrimary}" />
    <SolidColorBrush x:Key="Cv.Brush.Surface" Color="{StaticResource Cv.Color.Surface}" />
    <SolidColorBrush x:Key="Cv.Brush.SurfaceSubtle" Color="{StaticResource Cv.Color.SurfaceSubtle}" />
    <SolidColorBrush x:Key="Cv.Brush.TopBar" Color="{StaticResource Cv.Color.TopBar}" />
    <SolidColorBrush x:Key="Cv.Brush.Border" Color="{StaticResource Cv.Color.Border}" />
    <SolidColorBrush x:Key="Cv.Brush.InputBorder" Color="{StaticResource Cv.Color.InputBorder}" />
    <SolidColorBrush x:Key="Cv.Brush.Text" Color="{StaticResource Cv.Color.Text}" />
    <SolidColorBrush x:Key="Cv.Brush.MutedText" Color="{StaticResource Cv.Color.MutedText}" />
    <SolidColorBrush x:Key="Cv.Brush.PlaceholderText" Color="{StaticResource Cv.Color.PlaceholderText}" />
    <SolidColorBrush x:Key="Cv.Brush.Hover" Color="{StaticResource Cv.Color.Hover}" />
    <SolidColorBrush x:Key="Cv.Brush.Selected" Color="{StaticResource Cv.Color.Selected}" />
    <SolidColorBrush x:Key="Cv.Brush.SelectedText" Color="{StaticResource Cv.Color.SelectedText}" />
    <SolidColorBrush x:Key="Cv.Brush.SelectedIndicator" Color="{StaticResource Cv.Color.SelectedIndicator}" />
    <SolidColorBrush x:Key="Cv.Brush.Focus" Color="{StaticResource Cv.Color.Focus}" />
    <SolidColorBrush x:Key="Cv.Brush.Success" Color="{StaticResource Cv.Color.Success}" />
    <SolidColorBrush x:Key="Cv.Brush.SuccessBackground" Color="{StaticResource Cv.Color.SuccessBackground}" />
    <SolidColorBrush x:Key="Cv.Brush.Warning" Color="{StaticResource Cv.Color.Warning}" />
    <SolidColorBrush x:Key="Cv.Brush.WarningBackground" Color="{StaticResource Cv.Color.WarningBackground}" />
    <SolidColorBrush x:Key="Cv.Brush.Danger" Color="{StaticResource Cv.Color.Danger}" />
    <SolidColorBrush x:Key="Cv.Brush.DangerHover" Color="{StaticResource Cv.Color.DangerHover}" />
    <SolidColorBrush x:Key="Cv.Brush.DangerBackground" Color="{StaticResource Cv.Color.DangerBackground}" />
    <SolidColorBrush x:Key="Cv.Brush.Sensitive" Color="{StaticResource Cv.Color.Sensitive}" />
    <SolidColorBrush x:Key="Cv.Brush.SensitiveBackground" Color="{StaticResource Cv.Color.SensitiveBackground}" />
    <SolidColorBrush x:Key="Cv.Brush.DisabledBackground" Color="{StaticResource Cv.Color.DisabledBackground}" />
    <SolidColorBrush x:Key="Cv.Brush.DisabledText" Color="{StaticResource Cv.Color.DisabledText}" />
    <!-- Fondo semitransparente detrás de paneles superpuestos (configuración). -->
    <SolidColorBrush x:Key="Cv.Brush.Overlay" Color="#0F172A" Opacity="0.25" />

    <!-- ===== Tipografía ===== -->
    <FontFamily x:Key="Cv.Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Cv.Font.Code">Cascadia Mono, Consolas</FontFamily>
    <!-- Segoe Fluent Icons existe en Windows 11; Segoe MDL2 Assets es el respaldo en Windows 10. -->
    <FontFamily x:Key="Cv.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="Cv.FontSize.Title">28</sys:Double>
    <sys:Double x:Key="Cv.FontSize.SectionTitle">18</sys:Double>
    <sys:Double x:Key="Cv.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="Cv.FontSize.Small">12</sys:Double>
    <sys:Double x:Key="Cv.FontSize.Icon">16</sys:Double>

    <!-- ===== Espaciado (DIP) ===== -->
    <sys:Double x:Key="Cv.Space.Xs">4</sys:Double>
    <sys:Double x:Key="Cv.Space.Sm">8</sys:Double>
    <sys:Double x:Key="Cv.Space.Md">12</sys:Double>
    <sys:Double x:Key="Cv.Space.Lg">16</sys:Double>
    <sys:Double x:Key="Cv.Space.Xl">24</sys:Double>
    <sys:Double x:Key="Cv.Space.Xxl">32</sys:Double>
    <Thickness x:Key="Cv.Padding.Content">24</Thickness>
    <Thickness x:Key="Cv.Padding.Button">12,0,12,0</Thickness>

    <!-- ===== Forma ===== -->
    <CornerRadius x:Key="Cv.Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Cv.Radius.Panel">8</CornerRadius>
    <Thickness x:Key="Cv.Border.Thickness">1</Thickness>
    <Thickness x:Key="Cv.Border.Bottom">0,0,0,1</Thickness>
    <Thickness x:Key="Cv.Border.Right">0,0,1,0</Thickness>
    <Thickness x:Key="Cv.Focus.Thickness">2</Thickness>

    <!-- ===== Medidas de layout ===== -->
    <sys:Double x:Key="Cv.Size.TopBarHeight">48</sys:Double>
    <GridLength x:Key="Cv.Size.TopBarGridHeight">48</GridLength>
    <sys:Double x:Key="Cv.Size.ShellBarHeight">40</sys:Double>
    <sys:Double x:Key="Cv.Size.ButtonHeight">34</sys:Double>
    <sys:Double x:Key="Cv.Size.ButtonMinWidth">34</sys:Double>
    <GridLength x:Key="Cv.Width.Navigation">226</GridLength>
    <sys:Double x:Key="Cv.MinWidth.Navigation">190</sys:Double>
    <GridLength x:Key="Cv.Width.PageList">210</GridLength>
    <sys:Double x:Key="Cv.MinWidth.PageList">190</sys:Double>
    <sys:Double x:Key="Cv.MaxWidth.Readable">760</sys:Double>
    <!-- Mínimo del contenido: con navegación y páginas al mínimo (190 + 190) la
         Biblioteca cabe en el ancho mínimo actual de la ventana (700) sin solaparse. -->
    <sys:Double x:Key="Cv.MinWidth.Content">300</sys:Double>
</ResourceDictionary>
