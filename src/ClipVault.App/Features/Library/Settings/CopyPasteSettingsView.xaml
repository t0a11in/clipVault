<!--
    Panel de configuración de copiado y pegado (etapa 9). Maqueta: las opciones
    viven en memoria. Se abre con ⚙ y se cierra con Esc, la × o clic fuera del panel.
    DataContext: LibraryViewModel (usa Settings, Editor y CloseSettingsCommand).
-->
<UserControl x:Class="ClipVault.App.Features.Library.Settings.CopyPasteSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:library="clr-namespace:ClipVault.App.Features.Library"
             xmlns:settings="clr-namespace:ClipVault.App.Features.Library.Settings"
             xmlns:converters="clr-namespace:ClipVault.App.Converters"
             xmlns:behaviors="clr-namespace:ClipVault.App.Components.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=library:LibraryViewModel}"
             d:DesignWidth="420" d:DesignHeight="700">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumToBooleanConverter x:Key="EnumToBool" />
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Cv.Text.Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Option" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontFamily" Value="{DynamicResource Cv.Font.Ui}" />
            <Setter Property="FontSize" Value="{DynamicResource Cv.FontSize.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource Cv.Brush.Text}" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Option}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource Option}" />
    </UserControl.Resources>

    <Border Background="{DynamicResource Cv.Brush.Surface}"
            BorderBrush="{DynamicResource Cv.Brush.Border}"
            BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Encabezado -->
            <Border DockPanel.Dock="Top"
                    Height="{DynamicResource Cv.Size.TopBarHeight}"
                    Padding="20,0,12,0"
                    Background="{DynamicResource Cv.Brush.TopBar}"
                    BorderBrush="{DynamicResource Cv.Brush.Border}"
                    BorderThickness="{DynamicResource Cv.Border.Bottom}">
                <DockPanel>
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Cv.Button.Icon}"
                            Content="&#xE711;"
                            Command="{Binding CloseSettingsCommand}"
                            ToolTip="Cerrar (Esc)"
                            AutomationProperties.Name="Cerrar configuración"
                            behaviors:InlineEdit.FocusWhenVisible="True" />
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource Cv.Text.SectionTitle}"
                               Text="Copiar y pegar" />
                </DockPanel>
            </Border>

            <!-- Pie: vista previa y acción Copiar -->
            <Border DockPanel.Dock="Bottom"
                    Padding="20,12,20,16"
                    Background="{DynamicResource Cv.Brush.SurfaceSubtle}"
                    BorderBrush="{DynamicResource Cv.Brush.Border}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Cv.Text.FieldLabel}" Text="Vista previa de lo que se copiará" />
                    <TextBox Style="{StaticResource Cv.TextBox.Code}"
                             MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Editor.PreviewCopyText, Mode=OneWay}"
                             AutomationProperties.Name="Vista previa de la copia" />
                    <TextBlock Margin="0,6,0,10"
                               Style="{StaticResource Cv.Text.Small}"
                               Text="Los datos sensibles nunca se incluyen aquí." />
                    <Button HorizontalAlignment="Left"
                            Style="{StaticResource Cv.Button.Primary}"
                            Command="{Binding Editor.CopyCommand}"
                            ToolTip="Copiar la página seleccionada con esta configuración"
                            AutomationProperties.Name="Copiar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Cv.Text.Icon}" Margin="0,0,8,0" Text="&#xE8C8;" />
                            <TextBlock VerticalAlignment="Center" Text="Copiar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="20,0,20,20" DataContext="{Binding Settings}">
                    <!-- Modo de copiado -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Modo de copiado" />
                    <RadioButton GroupName="CopyMode" Content="Copiar valor original"
                                 ToolTip="La plantilla tal cual, sin reemplazar variables"
                                 IsChecked="{Binding CopyMode, Converter={StaticResource EnumToBool}, ConverterParameter=Original}" />
                    <RadioButton GroupName="CopyMode" Content="Copiar comando renderizado"
                                 ToolTip="Con $archivo reemplazado (predeterminado)"
                                 IsChecked="{Binding CopyMode, Converter={StaticResource EnumToBool}, ConverterParameter=Rendered}" />
                    <RadioButton GroupName="CopyMode" Content="Copiar como bloque de código"
                                 ToolTip="Entre ``` para pegar en chats o documentos Markdown"
                                 IsChecked="{Binding CopyMode, Converter={StaticResource EnumToBool}, ConverterParameter=CodeBlock}" />
                    <RadioButton GroupName="CopyMode" Content="Copiar solo campos seleccionados"
                                 IsChecked="{Binding CopyMode, Converter={StaticResource EnumToBool}, ConverterParameter=SelectedFields}" />
                    <Border Margin="24,0,0,4"
                            Padding="12,8,12,4"
                            Background="{DynamicResource Cv.Brush.SurfaceSubtle}"
                            CornerRadius="{DynamicResource Cv.Radius.Control}"
                            Visibility="{Binding IsSelectedFieldsMode, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding FieldOptions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type settings:CopyFieldOption}">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Modo de pegado -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Modo de pegado" />
                    <CheckBox Content="Pegar en el campo activo"
                              ToolTip="Maqueta: se conectará con el modo edición en una etapa posterior"
                              IsChecked="{Binding PasteIntoActiveField}" />
                    <CheckBox Content="Usar el portapapeles como valor de las variables"
                              ToolTip="Habilita el botón «Pegar» de la plantilla"
                              IsChecked="{Binding UseClipboardForFileVariable}" />
                    <CheckBox Content="Solicitar confirmación antes de reemplazar un campo"
                              IsChecked="{Binding ConfirmBeforeReplace}" />
                    <CheckBox Content="No capturar automáticamente contenido sensible"
                              ToolTip="Rechaza pegar textos que parecen contraseñas, tokens o llaves"
                              IsChecked="{Binding RejectSensitivePaste}" />

                    <!-- Variables -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Variables" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource Cv.Text.Muted}" Text="Variables" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Cv.Font.Code}"
                                   Foreground="{DynamicResource Cv.Brush.SelectedText}"
                                   Text="{Binding VariableToken}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,6" Style="{StaticResource Cv.Text.Muted}" Text="Campo de origen" />
                    <RadioButton GroupName="FileSource" Content="Deducir del campo «Ejemplo»"
                                 ToolTip="repopack &quot;$archivo&quot; + repopack &quot;D:\x\&quot; → D:\x\"
                                 IsChecked="{Binding FileVariableSource, Converter={StaticResource EnumToBool}, ConverterParameter=Example}" />
                    <RadioButton GroupName="FileSource" Content="Selector de archivo (valor de demostración)"
                                 IsChecked="{Binding FileVariableSource, Converter={StaticResource EnumToBool}, ConverterParameter=FilePicker}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Cv.Text.Small}"
                               Text="El origen se aplica a cada variable al abrir una página que aún no tiene valor para ella. $fecha usa la fecha de hoy si no se deduce." />

                    <Border Margin="0,18,0,0"
                            Padding="10,8,10,8"
                            Background="{DynamicResource Cv.Brush.WarningBackground}"
                            CornerRadius="{DynamicResource Cv.Radius.Control}">
                        <TextBlock Style="{StaticResource Cv.Text.Small}"
                                   Foreground="{DynamicResource Cv.Brush.Warning}"
                                   Text="Maqueta: estas opciones viven en memoria y se pierden al cerrar ClipVault." />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
