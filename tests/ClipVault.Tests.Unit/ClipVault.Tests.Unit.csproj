<!--
    Pruebas unitarias de ClipVault (xUnit).
    - net10.0-windows + UseWPF: los ViewModels viven en ClipVault.App, que es un proyecto WPF.
    - Las pruebas no abren ventanas ni tocan el portapapeles ni la base de datos.
    - Moq simula las dependencias (ILibraryDataSource, IClipboardService, IConfirmationService,
      IClipRepository, servicios de diálogo…). Versión 4.20.72: posterior a la retirada de
      SponsorLink (4.20.0); revisar sus notas antes de actualizar.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClipVault.Core\ClipVault.Core.csproj" />
    <ProjectReference Include="..\..\src\ClipVault.App\ClipVault.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Evita escribir "using Xunit;" en cada archivo de prueba. -->
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
